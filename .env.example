# Optional analytics + search-console verification.
# Set these in Cloudflare Pages → Project → Settings → Environment Variables.
# Leave blank to disable. The PUBLIC_ prefix is required for client-side access in Astro.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# Get yours at https://analytics.google.com → Admin → Data Streams
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console site-verification token (just the content of the meta tag, without quotes)
# Get yours at https://search.google.com/search-console → Settings → Ownership verification → HTML tag
PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools site-verification token
# Get yours at https://www.bing.com/webmasters → Site → Ownership verification → Option 2: Meta tag
PUBLIC_BING_VERIFICATION=
