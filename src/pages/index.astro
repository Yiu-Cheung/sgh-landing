---
import BaseLayout from '../layouts/BaseLayout.astro';

// TODO(polar-checkout-url): Polar product checkout URLs. Update if the Polar variant IDs change.
const POLAR_ANNUAL = 'https://buy.polar.sh/polar_cl_F7zNynx5wcSfUm96w3eklh2cXR10EYJPdIGMB0rJnYg';
const POLAR_LIFETIME = 'https://buy.polar.sh/polar_cl_sP7CCTfGJkuLVDJWgGxhDSf0MtfLYugySxlos3DfaVW';

const faq = [
  {
    q: 'Which stock photo agencies does Smart Gallery Hub submit to?',
    a: 'Adobe Stock, Shutterstock, and Getty Images / iStock. SGH uploads files via each agency’s native channel (SFTP for Adobe, FTPS for Shutterstock, S3 for Getty) and then drives the contributor portal to file the submission for you.',
  },
  {
    q: 'Do I need a paid AI subscription to use Smart Gallery Hub?',
    a: 'No. SGH ships with a local Ollama integration — download a vision model once and run it on your own CPU or GPU, completely free. The AI runs entirely on your machine, so there is no per-image fee and no cloud subscription.',
  },
  {
    q: 'Does the Free tier really work forever?',
    a: 'Yes. The Free tier is permanent. You can generate AI metadata for unlimited photos and videos, organize them with content-type folders, edit keywords in bulk, write IPTC/XMP metadata back into files — all at no cost, forever. On Free, up to 30 keywords per image are written to the file; on Pro, up to 50 are written.',
  },
  {
    q: 'Does Smart Gallery Hub support stock video?',
    a: 'Yes. SGH extracts representative frames from MP4 / MOV / etc., runs the vision model on them, and submits the clips to agencies that accept stock video. The workflow is identical to still photography.',
  },
  {
    q: 'What about my agency passwords — do you store them?',
    a: 'No. Smart Gallery Hub runs entirely on your machine. Agency credentials live in a local browser profile on your disk so the automated portal sessions can log in. Nothing leaves your computer — we have no server that sees your credentials, your images, your metadata, or your earnings.',
  },
  {
    q: 'Which platforms does Smart Gallery Hub run on?',
    a: 'Windows 10 or later (64-bit) and macOS (Apple Silicon and Intel, separate builds). Same feature set on both platforms. Mobile and tablet access is available via the built-in remote web UI, so you can review your library from your phone while your desktop keeps processing.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 pt-20 pb-16 text-center">
    <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-gray-900 leading-tight">
      <span class="text-brand-600">One click.</span><br />
      Captioned. Uploaded. Submitted. Tracked.
    </h1>
    <p class="mt-6 text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto">
      Smart Gallery Hub turns a folder of stock photos and videos into live listings &mdash; automatically. AI writes the metadata, the app handles uploads to your stock platforms, and approvals come back to one dashboard. Drop a folder in. Walk away.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/download"
        class="bg-brand-600 text-white px-8 py-3 rounded-lg text-lg font-semibold hover:bg-brand-700 transition-colors shadow-lg shadow-brand-600/25"
      >
        Try Pro Free for 30 Days
      </a>
      <a
        href="#how-it-works"
        class="text-brand-600 px-8 py-3 rounded-lg text-lg font-semibold hover:bg-brand-50 transition-colors"
      >
        See how it works &darr;
      </a>
    </div>
    <p class="mt-4 text-xs text-gray-500">Free tier forever &middot; no credit card &middot; Windows &amp; Mac</p>
    <div class="mt-16 rounded-xl overflow-hidden shadow-2xl border border-gray-200 max-w-5xl mx-auto">
      <img
        src="/main.png"
        alt="Smart Gallery Hub workspace: AI metadata for stock photos, multi-agency submission status, and monthly earnings dashboard"
        class="w-full"
        loading="eager"
      />
      <p class="text-xs text-gray-400 text-center bg-gray-50 py-2 border-t border-gray-100">
        Smart Gallery Hub Pro shown &mdash; earnings dashboard and auto-submission require Pro.
      </p>
    </div>
  </section>

  <!-- One-click value prop -->
  <section class="bg-gray-900 text-gray-100 py-20">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold">What one click actually does.</h2>
      <p class="mt-6 text-lg text-gray-300 max-w-2xl mx-auto">
        Smart Gallery Hub writes the description, picks the keywords, organizes by content type, uploads to your stock platforms, and tracks every approval. You drop a folder in. It does the rest.
      </p>
      <div class="mt-12 grid grid-cols-2 gap-6 sm:flex sm:items-start sm:justify-center sm:gap-2 text-center">
        <div class="sm:flex-1 sm:max-w-[14rem]">
          <div class="text-3xl mb-2">&#x270F;&#xFE0F;</div>
          <div class="text-xl font-bold text-brand-600">Description</div>
          <div class="mt-2 text-sm text-gray-400">written by AI</div>
        </div>
        <div class="hidden sm:flex items-center justify-center text-3xl text-gray-500 pt-3 shrink-0" aria-hidden="true">&rarr;</div>
        <div class="sm:flex-1 sm:max-w-[14rem]">
          <div class="text-3xl mb-2">&#x1F3F7;&#xFE0F;</div>
          <div class="text-xl font-bold text-brand-600">AI keywords</div>
          <div class="mt-2 text-sm text-gray-400">up to 50 keywords</div>
        </div>
        <div class="hidden sm:flex items-center justify-center text-3xl text-gray-500 pt-3 shrink-0" aria-hidden="true">&rarr;</div>
        <div class="sm:flex-1 sm:max-w-[14rem]">
          <div class="text-3xl mb-2">&#x1F4E4;</div>
          <div class="text-xl font-bold text-brand-600">Upload + submit</div>
          <div class="mt-2 text-sm text-gray-400">direct to portal</div>
        </div>
        <div class="hidden sm:flex items-center justify-center text-3xl text-gray-500 pt-3 shrink-0" aria-hidden="true">&rarr;</div>
        <div class="sm:flex-1 sm:max-w-[14rem]">
          <div class="text-3xl mb-2">&#x2705;</div>
          <div class="text-xl font-bold text-brand-600">Approvals tracked</div>
          <div class="mt-2 text-sm text-gray-400">automatically</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-gray-900">From folder to live listing, in four steps.</h2>
      <p class="mt-4 text-center text-gray-600 max-w-xl mx-auto">
        Drop a folder. SGH handles metadata, organization, submission, and tracking.
      </p>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="relative rounded-xl border border-gray-200 p-6 bg-white">
          <div class="absolute -top-3 left-6 bg-brand-600 text-white text-xs font-bold w-7 h-7 rounded-full flex items-center justify-center">1</div>
          <h3 class="mt-2 font-semibold text-gray-900">Add folder, pick content type</h3>
          <p class="mt-2 text-sm text-gray-600">Drop a folder into a Commercial, Editorial, AI-Generated, or Illustration workspace. Each workspace applies the right metadata fields and agency category mapping &mdash; no more wrong-type rejections.</p>
        </div>
        <div class="relative rounded-xl border border-gray-200 p-6 bg-white">
          <div class="absolute -top-3 left-6 bg-brand-600 text-white text-xs font-bold w-7 h-7 rounded-full flex items-center justify-center">2</div>
          <h3 class="mt-2 font-semibold text-gray-900">AI writes the metadata</h3>
          <p class="mt-2 text-sm text-gray-600">The AI model generates titles, descriptions, and keywords per file. Optional: drop a hints file in the folder to steer the AI toward more accurate output.</p>
        </div>
        <div class="relative rounded-xl border border-gray-200 p-6 bg-white">
          <div class="absolute -top-3 left-6 bg-brand-600 text-white text-xs font-bold w-7 h-7 rounded-full flex items-center justify-center">3</div>
          <h3 class="mt-2 font-semibold text-gray-900">Submit to all three agencies</h3>
          <p class="mt-2 text-sm text-gray-600">SGH uploads to Adobe Stock, Shutterstock, and Getty. It retries failures and EXIF-stamps every submitted file to help prevent the same image going out twice.</p>
        </div>
        <div class="relative rounded-xl border border-gray-200 p-6 bg-white">
          <div class="absolute -top-3 left-6 bg-brand-600 text-white text-xs font-bold w-7 h-7 rounded-full flex items-center justify-center">4</div>
          <h3 class="mt-2 font-semibold text-gray-900">Enjoy your coffee</h3>
          <p class="mt-2 text-sm text-gray-600">SGH keeps submitting, retrying, and tracking approvals in the background. Approvals and earnings roll into one dashboard while you go shoot, edit, or just take a break.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="bg-gray-50 py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-gray-900">Everything the manual stock photo workflow makes you do.</h2>
      <p class="mt-4 text-center text-gray-600 max-w-xl mx-auto">
        One desktop app. Three agencies. The full pipeline &mdash; AI metadata, submission, tracking, earnings.
      </p>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F916;</div>
          <h3 class="font-semibold text-gray-900">AI metadata generation</h3>
          <p class="mt-2 text-sm text-gray-600">AI reads each image or video and writes the title, description, and keywords. Editorial content gets a different caption format &mdash; the one each agency expects.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F680;</div>
          <h3 class="font-semibold text-gray-900">Direct submission to Adobe / Shutter / Getty</h3>
          <p class="mt-2 text-sm text-gray-600">SGH uploads your files to Adobe, Shutterstock, and Getty and files the submission for you. No dragging files into three different browser tabs.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F501;</div>
          <h3 class="font-semibold text-gray-900">Submission queue + resume</h3>
          <p class="mt-2 text-sm text-gray-600">Sends submissions one agency at a time, retries when something fails, and picks up where it left off after a crash. Drop a thousand files in. Walk away.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x2705;</div>
          <h3 class="font-semibold text-gray-900">Approval &amp; rejection tracking</h3>
          <p class="mt-2 text-sm text-gray-600">SGH checks each agency for you and shows what was accepted or rejected &mdash; so you don&rsquo;t need to open three browser tabs to find out.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F4B0;</div>
          <h3 class="font-semibold text-gray-900">All earnings, one dashboard</h3>
          <p class="mt-2 text-sm text-gray-600">Brings your earnings from Adobe, Shutterstock, and Getty into one chart. See monthly totals, your top-earning files, and which agency pays you the most.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F4F0;</div>
          <h3 class="font-semibold text-gray-900">Location-aware AI</h3>
          <p class="mt-2 text-sm text-gray-600">When your photo contains GPS data, SGH turns it into a real city + country and feeds that to the AI &mdash; for more accurate descriptions, sharper keywords, and the date + city + country prefix every editorial submission needs.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F4C1;</div>
          <h3 class="font-semibold text-gray-900">Content-type folders</h3>
          <p class="mt-2 text-sm text-gray-600">Label folders as Commercial, Editorial, AI-Generated, or Illustration. Each one gets the right fields and the right category for every agency &mdash; so wrong-type submissions get caught before they go out.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F441;&#xFE0F;</div>
          <h3 class="font-semibold text-gray-900">Watch folders</h3>
          <p class="mt-2 text-sm text-gray-600">Drop new images into a watched folder. SGH picks them up, writes the metadata, and queues them for submission on its own. Set it up once.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F39E;&#xFE0F;</div>
          <h3 class="font-semibold text-gray-900">Photo &amp; video</h3>
          <p class="mt-2 text-sm text-gray-600">Same workflow for stock video. SGH grabs a few frames, lets the AI describe the clip, and submits it to agencies that accept video.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F4F1;</div>
          <h3 class="font-semibold text-gray-900">Mobile + remote access</h3>
          <p class="mt-2 text-sm text-gray-600">Shoot on your smartphone, import to your home server, and run the full submission &mdash; all from your phone. Your desktop does the work in the background.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F4E6;</div>
          <h3 class="font-semibold text-gray-900">Export &amp; no duplicates</h3>
          <p class="mt-2 text-sm text-gray-600">Export a CSV in each agency&rsquo;s exact format, or save the metadata straight into the image file. Already-submitted files are remembered &mdash; designed to prevent duplicate submissions.</p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="w-10 h-10 bg-brand-50 rounded-lg flex items-center justify-center text-brand-600 text-xl mb-4">&#x1F512;</div>
          <h3 class="font-semibold text-gray-900">Local-first</h3>
          <p class="mt-2 text-sm text-gray-600">Your images stay on your machine. The AI runs on your computer. Nothing uploaded for us to see, nothing trained on your work.</p>
        </div>
      </div>

      <!-- Feature spotlights with real screenshots -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="rounded-xl overflow-hidden shadow-lg border border-gray-200 bg-white">
          <img
            src="/features/ai-hints.png"
            alt="AI hints panel — set a location, prefix, category, and keywords once to guide AI metadata generation across a folder of stock photos"
            class="w-full"
            loading="lazy"
          />
          <div class="p-4">
            <h4 class="font-semibold text-gray-900">Hints &mdash; one setting, sharper results</h4>
            <p class="text-sm text-gray-600 mt-1">Set a location (or category, prefix, must-have keywords) once for a folder. The AI uses your hints across every image in the batch &mdash; for noticeably more accurate descriptions and keywords.</p>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden shadow-lg border border-gray-200 bg-white">
          <img
            src="/features/auto-editorial-caption.png"
            alt="AI-generated editorial caption with auto-filled GPS location and date for a stock photo"
            class="w-full"
            loading="lazy"
          />
          <div class="p-4">
            <h4 class="font-semibold text-gray-900">Editorial captions, written by AI</h4>
            <p class="text-sm text-gray-600 mt-1">Date, city, country, and a fact-based description &mdash; written automatically from GPS and EXIF.</p>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden shadow-lg border border-gray-200 bg-white">
          <img
            src="/features/agents-status.png"
            alt="Approval tracking dashboard for Adobe Stock, Shutterstock, and Getty Images stock photo submissions"
            class="w-full"
            loading="lazy"
          />
          <div class="p-4">
            <h4 class="font-semibold text-gray-900">Approval tracking, three agencies</h4>
            <p class="text-sm text-gray-600 mt-1">See submitted, approved, and rejected counts for Adobe, Shutterstock, and Getty at a glance.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Work remotely (mobile web) -->
  <section id="mobile" class="py-20 bg-gradient-to-b from-white to-gray-50">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-brand-50 text-brand-600 text-2xl">&#x1F4F1;</div>
      <h2 class="mt-6 text-3xl sm:text-4xl font-bold text-gray-900">Out shooting? Run the whole pipeline from your phone.</h2>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Import new captures straight to your home server, run the AI metadata, and submit to Adobe Stock, Shutterstock, and Getty &mdash; all from the mobile web UI on the same network as your desktop. Your work never leaves the network.
      </p>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
        <div class="flex flex-col items-center">
          <div class="rounded-[2rem] overflow-hidden border-[6px] border-gray-900 shadow-2xl bg-gray-900 max-w-[260px]">
            <img
              src="/features/mobile-view-import.png"
              alt="Smart Gallery Hub mobile web interface &mdash; importing photos to a home server from a phone"
              class="w-full block"
              loading="lazy"
            />
          </div>
          <div class="mt-6 max-w-xs">
            <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-brand-600 text-white text-xs font-bold">1</div>
            <h3 class="mt-3 font-semibold text-gray-900">Import to your home server</h3>
            <p class="mt-2 text-sm text-gray-600">Tap &ldquo;Import&rdquo; on your phone. New shots go straight into the right Editorial or Commercial workspace on your home desktop.</p>
          </div>
        </div>

        <div class="flex flex-col items-center">
          <div class="rounded-[2rem] overflow-hidden border-[6px] border-gray-900 shadow-2xl bg-gray-900 max-w-[260px]">
            <img
              src="/features/mobile-view.png"
              alt="Smart Gallery Hub mobile library view &mdash; stock photo grid on a phone"
              class="w-full block"
              loading="lazy"
            />
          </div>
          <div class="mt-6 max-w-xs">
            <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-brand-600 text-white text-xs font-bold">2</div>
            <h3 class="mt-3 font-semibold text-gray-900">Review on any screen</h3>
            <p class="mt-2 text-sm text-gray-600">Browse, filter, and check approvals on your phone or tablet. Same library, same content-type folders, same status badges as on the desktop.</p>
          </div>
        </div>

        <div class="flex flex-col items-center">
          <div class="rounded-[2rem] overflow-hidden border-[6px] border-gray-900 shadow-2xl bg-gray-900 max-w-[260px]">
            <img
              src="/features/mobile-view-operation.png"
              alt="Smart Gallery Hub mobile operation bar with AI, Adobe, Shutterstock, and Getty submission buttons"
              class="w-full block"
              loading="lazy"
            />
          </div>
          <div class="mt-6 max-w-xs">
            <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-brand-600 text-white text-xs font-bold">3</div>
            <h3 class="mt-3 font-semibold text-gray-900">Trigger the full submission</h3>
            <p class="mt-2 text-sm text-gray-600">One tap to run AI metadata. One tap to submit to Adobe, Shutterstock, or Getty. The desktop does the heavy lifting in the background.</p>
          </div>
        </div>
      </div>

      <div class="mt-12 inline-flex items-start gap-3 rounded-xl bg-brand-50 border-2 border-brand-600 text-left p-5 max-w-2xl mx-auto">
        <span class="text-brand-600 text-2xl shrink-0 leading-none mt-0.5">&#x1F512;</span>
        <p class="text-sm sm:text-base text-gray-900 font-medium leading-relaxed">
          Mobile access uses the same private network as your desktop &mdash; <span class="text-brand-700 font-bold">no third-party server, no cloud relay.</span> Your library stays on the machine that owns it.
        </p>
      </div>
    </div>
  </section>

  <!-- Comparison (anonymized) -->
  <section id="compare" class="py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-5xl sm:text-7xl font-bold text-center text-gray-900 leading-none">
        <span class="text-brand-600">Only</span> Smart Gallery Hub.
      </h2>
      <p class="mt-10 text-lg sm:text-2xl text-center text-gray-700 max-w-3xl mx-auto leading-relaxed">
        The only local desktop app that ships AI metadata, submission, approval tracking, and earnings &mdash; <span class="font-bold text-gray-900">all unlimited, all in one place.</span>
      </p>

      <p class="mt-12 text-center text-sm text-gray-500 max-w-2xl mx-auto">
        The full feature-by-feature comparison is below.
      </p>

      <div class="mt-12 overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
        <table class="w-full text-sm bg-white">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-50">
              <th class="text-left py-4 px-4 font-semibold text-gray-700 w-64 sticky left-0 bg-gray-50 z-10">Feature</th>
              <th class="py-4 px-2 text-center font-bold text-brand-700 bg-brand-50 whitespace-nowrap min-w-[7rem]">
                SGH
                <div class="text-[10px] font-normal text-brand-600/80 mt-0.5">all-in-one</div>
              </th>
              <th class="py-4 px-2 text-center font-medium text-gray-700 whitespace-nowrap min-w-[6rem]">
                Cloud A
                <div class="text-[10px] font-normal text-gray-500 mt-0.5">AI keywording</div>
              </th>
              <th class="py-4 px-2 text-center font-medium text-gray-700 whitespace-nowrap min-w-[6rem]">
                Cloud B
                <div class="text-[10px] font-normal text-gray-500 mt-0.5">submission hub</div>
              </th>
              <th class="py-4 px-2 text-center font-medium text-gray-700 whitespace-nowrap min-w-[6rem]">
                Cloud C
                <div class="text-[10px] font-normal text-gray-500 mt-0.5">all-in-one</div>
              </th>
              <th class="py-4 px-2 text-center font-medium text-gray-700 whitespace-nowrap min-w-[6rem]">
                Desktop A
                <div class="text-[10px] font-normal text-gray-500 mt-0.5">metadata editor</div>
              </th>
              <th class="py-4 px-2 text-center font-medium text-gray-700 whitespace-nowrap min-w-[6rem]">
                Desktop B
                <div class="text-[10px] font-normal text-gray-500 mt-0.5">auto-submitter</div>
              </th>
