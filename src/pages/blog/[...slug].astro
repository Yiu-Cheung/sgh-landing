---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Smart Gallery Hub' },
};
---

<BaseLayout
  title={`${post.data.title} | Smart Gallery Hub blog`}
  description={post.data.description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />

  <article class="max-w-3xl mx-auto px-4 pt-20 pb-20">
    <p class="text-sm font-semibold text-brand-600 uppercase tracking-wide">
      <a href="/blog/" class="hover:underline">&larr; Back to blog</a>
    </p>
    <header class="mt-4">
      <h1 class="text-3xl sm:text-5xl font-bold text-gray-900 leading-tight">{post.data.title}</h1>
      <p class="mt-4 text-sm text-gray-500">
        <span>{dateFmt(post.data.publishDate)}</span>
        {post.data.updatedDate && (
          <>
            <span class="mx-2">&middot;</span>
            <span>Updated {dateFmt(post.data.updatedDate)}</span>
          </>
        )}
        <span class="mx-2">&middot;</span>
        <span>{post.data.author}</span>
      </p>
    </header>

    <div
      class="mt-10 text-gray-800 leading-relaxed
             [&_h2]:text-2xl [&_h2]:sm:text-3xl [&_h2]:font-bold [&_h2]:text-gray-900 [&_h2]:mt-12 [&_h2]:mb-4
             [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-gray-900 [&_h3]:mt-8 [&_h3]:mb-3
             [&_p]:mt-4 [&_p]:leading-relaxed
             [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:my-4 [&_ul]:space-y-2
             [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:my-4 [&_ol]:space-y-2
             [&_li]:leading-relaxed
             [&_a]:text-brand-600 [&_a]:underline [&_a]:hover:text-brand-700
             [&_blockquote]:border-l-4 [&_blockquote]:border-brand-600 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-gray-700 [&_blockquote]:my-6
             [&_code]:bg-gray-100 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-sm [&_code]:font-mono
             [&_hr]:my-10 [&_hr]:border-gray-200
             [&_strong]:text-gray-900 [&_em]:text-gray-700"
    >
      <Content />
    </div>

    <div class="mt-16 pt-8 border-t border-gray-200">
      <p class="text-sm text-gray-500">
        <a href="/blog/" class="text-brand-600 hover:text-brand-700 hover:underline">&larr; More posts</a>
      </p>
    </div>
  </article>
</BaseLayout>
