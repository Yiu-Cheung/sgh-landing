---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Upload Image" description="Private image upload.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <section class="max-w-3xl mx-auto px-4 py-12">
    <!-- Login screen -->
    <div id="login-view" class="hidden">
      <h1 class="text-3xl font-bold text-gray-900">Sign in</h1>
      <p class="mt-2 text-sm text-gray-600">Enter the admin password.</p>
      <form id="login-form" class="mt-6 space-y-4">
        <input
          id="login-password"
          type="password"
          autocomplete="current-password"
          required
          placeholder="Password"
          class="block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
        />
        <button
          type="submit"
          class="w-full px-4 py-2.5 rounded-lg bg-brand-600 text-white text-sm font-semibold hover:bg-brand-700"
        >
          Sign in
        </button>
        <p id="login-error" class="hidden text-sm text-red-700"></p>
      </form>
    </div>

    <!-- Main view (visible once authed) -->
    <div id="main-view" class="hidden">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold text-gray-900">Image library</h1>
        <button
          id="logout-btn"
          class="text-sm text-gray-500 hover:text-gray-800 underline"
        >Sign out</button>
      </div>

      <!-- Upload section -->
      <div class="mt-6 rounded-xl border border-gray-200 bg-white p-5">
        <form id="upload-form" class="space-y-3">
          <label
            id="dropzone"
            for="file"
            class="flex flex-col items-center justify-center w-full h-32 rounded-lg border-2 border-dashed border-gray-300 cursor-pointer hover:border-brand-400 hover:bg-gray-50 transition-colors"
          >
            <span id="dropzone-text" class="text-sm text-gray-500">
              Click to choose or drop images here (multiple OK · PNG/JPG/WebP/GIF · max 10 MB each)
            </span>
            <input id="file" name="file" type="file" multiple accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" />
          </label>
          <button
            type="submit"
            id="submit-btn"
            class="w-full px-4 py-2.5 rounded-lg bg-brand-600 text-white text-sm font-semibold hover:bg-brand-700 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Upload
          </button>
          <p id="upload-status" class="hidden text-sm"></p>
        </form>
      </div>

      <!-- Gallery -->
      <h2 class="mt-10 text-lg font-semibold text-gray-900">Uploaded images</h2>
      <p id="gallery-empty" class="hidden mt-2 text-sm text-gray-500">No images yet.</p>
      <ul id="gallery" class="mt-4 space-y-3"></ul>
    </div>
  </section>

  <!-- Hidden file input used for "Replace" flow -->
  <input id="replace-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" />

  <script>
    const loginView = document.getElementById('login-view') as HTMLDivElement;
    const mainView = document.getElementById('main-view') as HTMLDivElement;
    const loginForm = document.getElementById('login-form') as HTMLFormElement;
    const loginPassword = document.getElementById('login-password') as HTMLInputElement;
    const loginError = document.getElementById('login-error') as HTMLParagraphElement;
    const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;

    const uploadForm = document.getElementById('upload-form') as HTMLFormElement;
    const fileInput = document.getElementById('file') as HTMLInputElement;
    const dropzone = document.getElementById('dropzone') as HTMLLabelElement;
    const dropzoneText = document.getElementById('dropzone-text') as HTMLSpanElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const uploadStatus = document.getElementById('upload-status') as HTMLParagraphElement;

    const gallery = document.getElementById('gallery') as HTMLUListElement;
    const galleryEmpty = document.getElementById('gallery-empty') as HTMLParagraphElement;
    const replaceFile = document.getElementById('replace-file') as HTMLInputElement;

    type Image = { key: string; url: string; size: number; uploaded: string };

    function showLogin(): void {
      loginView.classList.remove('hidden');
      mainView.classList.add('hidden');
    }

    function showMain(): void {
      loginView.classList.add('hidden');
      mainView.classList.remove('hidden');
    }

    function setStatus(el: HTMLElement, text: string, kind: 'ok' | 'err' | 'info'): void {
      el.textContent = text;
      el.classList.remove('hidden', 'text-red-700', 'text-green-700', 'text-gray-600');
      el.classList.add(
        kind === 'err' ? 'text-red-700' : kind === 'ok' ? 'text-green-700' : 'text-gray-600',
      );
    }

    function fmtSize(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
      return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
    }

    async function checkAuth(): Promise<boolean> {
      try {
        const res = await fetch('/api/auth', { credentials: 'include' });
        return res.ok;
      } catch {
        return false;
      }
    }

    async function refreshGallery(): Promise<void> {
      gallery.innerHTML = '';
      galleryEmpty.classList.add('hidden');
      try {
        const res = await fetch('/api/list', { credentials: 'include' });
        if (!res.ok) throw new Error(`Failed to list (${res.status})`);
        const data = (await res.json()) as { images: Image[] };
        if (data.images.length === 0) {
          galleryEmpty.classList.remove('hidden');
          return;
        }
        for (const img of data.images) {
          gallery.appendChild(renderImage(img));
        }
      } catch (err) {
        const li = document.createElement('li');
        li.className = 'text-sm text-red-700';
        li.textContent = err instanceof Error ? err.message : String(err);
        gallery.appendChild(li);
      }
    }

    function renderImage(img: Image, cacheBust?: number): HTMLLIElement {
      const li = document.createElement('li');
      li.className = 'rounded-xl border border-gray-200 bg-white p-3 flex flex-col sm:flex-row gap-3';
      li.dataset.key = img.key;

      const thumb = document.createElement('img');
      thumb.src = cacheBust ? `${img.url}?t=${cacheBust}` : img.url;
      thumb.alt = img.key;
      thumb.loading = 'lazy';
      thumb.className = 'w-full sm:w-32 h-32 object-cover rounded-lg bg-gray-100';
      li.appendChild(thumb);

      const right = document.createElement('div');
      right.className = 'flex-1 min-w-0 flex flex-col gap-2';

      const urlBox = document.createElement('div');
      urlBox.className = 'flex gap-2';
      const urlInput = document.createElement('input');
      urlInput.readOnly = true;
      urlInput.value = img.url;
      urlInput.className = 'flex-1 min-w-0 rounded border border-gray-300 px-2 py-1 text-xs font-mono bg-gray-50';
      urlBox.appendChild(urlInput);
      right.appendChild(urlBox);

      const meta = document.createElement('p');
      meta.className = 'text-xs text-gray-500';
      meta.textContent = `${fmtSize(img.size)} · ${new Date(img.uploaded).toLocaleString()}`;
      right.appendChild(meta);

      const actions = document.createElement('div');
      actions.className = 'flex flex-wrap gap-2 mt-auto';

      const copyBtn = (label: string, value: string): HTMLButtonElement => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.className = 'px-2.5 py-1 rounded bg-gray-200 hover:bg-gray-300 text-xs font-medium';
        b.addEventListener('click', async () => {
          await navigator.clipboard.writeText(value);
          const orig = b.textContent;
          b.textContent = 'Copied!';
          setTimeout(() => {
            b.textContent = orig;
          }, 1000);
        });
        return b;
      };

      actions.appendChild(copyBtn('URL', img.url));
      actions.appendChild(copyBtn('MD', `![](${img.url})`));
      actions.appendChild(copyBtn('BBCode', `[img]${img.url}[/img]`));

      const replaceBtn = document.createElement('button');
      replaceBtn.type = 'button';
      replaceBtn.textContent = 'Replace';
      replaceBtn.className = 'px-2.5 py-1 rounded bg-amber-100 hover:bg-amber-200 text-xs font-medium text-amber-900';
      replaceBtn.addEventListener('click', () => triggerReplace(img.key));
      actions.appendChild(replaceBtn);

      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.textContent = 'Delete';
      deleteBtn.className = 'px-2.5 py-1 rounded bg-red-100 hover:bg-red-200 text-xs font-medium text-red-900';
      deleteBtn.addEventListener('click', () => deleteImage(img.key));
      actions.appendChild(deleteBtn);

      right.appendChild(actions);
      li.appendChild(right);
      return li;
    }

    let pendingReplaceKey: string | null = null;
    function triggerReplace(key: string): void {
      pendingReplaceKey = key;
      replaceFile.value = '';
      replaceFile.click();
    }

    replaceFile.addEventListener('change', async () => {
      if (!pendingReplaceKey || !replaceFile.files?.[0]) return;
      const key = pendingReplaceKey;
      const file = replaceFile.files[0];
      pendingReplaceKey = null;

      const fd = new FormData();
      fd.append('key', key);
      fd.append('file', file);

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: fd,
          credentials: 'include',
        });
        const data = (await res.json()) as { error?: string; uploaded?: { url: string }[] };
        if (!res.ok) throw new Error(data.error ?? `Replace failed (${res.status})`);

        // Update only this item's thumbnail with a cache-buster so the new
        // bytes show immediately even though Cloudflare's edge may still
        // serve the old one for up to ~1h elsewhere.
        const li = gallery.querySelector(`li[data-key="${CSS.escape(key)}"]`);
        if (li) {
          const thumb = li.querySelector('img');
          if (thumb && data.uploaded?.[0]) {
            thumb.src = `${data.uploaded[0].url}?t=${Date.now()}`;
          }
        }
        setStatus(uploadStatus, `Replaced ${key}. Public URL may take up to ~1 hour to refresh for other viewers.`, 'ok');
      } catch (err) {
        setStatus(uploadStatus, err instanceof Error ? err.message : String(err), 'err');
      }
    });

    async function deleteImage(key: string): Promise<void> {
      if (!confirm(`Delete ${key}?`)) return;
      try {
        const res = await fetch(`/api/upload?key=${encodeURIComponent(key)}`, {
          method: 'DELETE',
          credentials: 'include',
        });
        const data = (await res.json()) as { error?: string };
        if (!res.ok) throw new Error(data.error ?? `Delete failed (${res.status})`);
        const li = gallery.querySelector(`li[data-key="${CSS.escape(key)}"]`);
        li?.remove();
        if (!gallery.querySelector('li')) galleryEmpty.classList.remove('hidden');
      } catch (err) {
        alert(err instanceof Error ? err.message : String(err));
      }
    }

    // --- Drop zone -------------------------------------------------------
    fileInput.addEventListener('change', () => {
      const n = fileInput.files?.length ?? 0;
      dropzoneText.textContent = n === 0
        ? 'Click to choose or drop images here (multiple OK · PNG/JPG/WebP/GIF · max 10 MB each)'
        : n === 1
        ? fileInput.files![0].name
        : `${n} files selected`;
    });

    ['dragover', 'dragenter'].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.add('border-brand-500', 'bg-brand-50');
      }),
    );
    ['dragleave', 'drop'].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.remove('border-brand-500', 'bg-brand-50');
      }),
    );
    dropzone.addEventListener('drop', (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (dt?.files.length) {
        fileInput.files = dt.files;
        fileInput.dispatchEvent(new Event('change'));
      }
    });

    // --- Upload submit ---------------------------------------------------
    uploadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const files = fileInput.files;
      if (!files || files.length === 0) {
        setStatus(uploadStatus, 'Pick at least one file', 'err');
        return;
      }
      submitBtn.disabled = true;
      submitBtn.textContent = 'Uploading…';
      setStatus(uploadStatus, `Uploading ${files.length} file(s)…`, 'info');

      const fd = new FormData();
      for (const f of files) fd.append('file', f);

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: fd,
          credentials: 'include',
        });
        const data = (await res.json()) as { error?: string; uploaded?: { url: string }[] };
        if (!res.ok) throw new Error(data.error ?? `Upload failed (${res.status})`);
        setStatus(uploadStatus, `Uploaded ${data.uploaded?.length ?? 0} file(s)`, 'ok');
        fileInput.value = '';
        fileInput.dispatchEvent(new Event('change'));
        await refreshGallery();
      } catch (err) {
        setStatus(uploadStatus, err instanceof Error ? err.message : String(err), 'err');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Upload';
      }
    });

    // --- Login + logout --------------------------------------------------
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginError.classList.add('hidden');
      try {
        const res = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ password: loginPassword.value }),
        });
        if (!res.ok) {
          const data = (await res.json()) as { error?: string };
          throw new Error(data.error ?? `Sign-in failed (${res.status})`);
        }
        loginPassword.value = '';
        showMain();
        await refreshGallery();
      } catch (err) {
        loginError.textContent = err instanceof Error ? err.message : String(err);
        loginError.classList.remove('hidden');
      }
    });

    logoutBtn.addEventListener('click', async () => {
      await fetch('/api/auth', { method: 'DELETE', credentials: 'include' });
      showLogin();
    });

    // --- Boot ------------------------------------------------------------
    (async () => {
      if (await checkAuth()) {
        showMain();
        await refreshGallery();
      } else {
        showLogin();
      }
    })();
  </script>
</BaseLayout>
