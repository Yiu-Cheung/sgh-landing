---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Upload Image" description="Private image upload.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-gray-900">Upload image</h1>
    <p class="mt-2 text-sm text-gray-600">
      Drops the image into R2 and gives you a public link to paste into forum posts.
      PNG / JPG / WebP / GIF, max 10 MB.
    </p>

    <form id="upload-form" class="mt-8 space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700">Password</label>
        <input
          id="password"
          type="password"
          autocomplete="current-password"
          required
          class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-brand-500 focus:ring-1 focus:ring-brand-500"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Image</label>
        <label
          id="dropzone"
          for="file"
          class="mt-1 flex flex-col items-center justify-center w-full h-40 rounded-lg border-2 border-dashed border-gray-300 cursor-pointer hover:border-brand-400 hover:bg-gray-50 transition-colors"
        >
          <span id="dropzone-text" class="text-sm text-gray-500">
            Click to choose or drop an image here
          </span>
          <input id="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" required />
        </label>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-brand-600 text-white text-sm font-semibold hover:bg-brand-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
      >
        Upload
      </button>
    </form>

    <div id="result" class="hidden mt-8 space-y-3">
      <div id="preview-wrap" class="rounded-lg border border-gray-200 bg-gray-50 p-3">
        <img id="preview" alt="" class="max-h-64 mx-auto rounded" />
      </div>
      <div class="space-y-2">
        <div class="flex gap-2">
          <input id="raw-url" readonly class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono bg-white" />
          <button data-copy="raw-url" class="px-3 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 text-sm font-medium">URL</button>
        </div>
        <div class="flex gap-2">
          <input id="md-url" readonly class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono bg-white" />
          <button data-copy="md-url" class="px-3 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 text-sm font-medium">MD</button>
        </div>
        <div class="flex gap-2">
          <input id="bb-url" readonly class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono bg-white" />
          <button data-copy="bb-url" class="px-3 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 text-sm font-medium">BBCode</button>
        </div>
      </div>
    </div>

    <div id="error" class="hidden mt-4 rounded-lg border border-red-200 bg-red-50 text-red-800 text-sm p-3"></div>
  </section>

  <script>
    const form = document.getElementById('upload-form') as HTMLFormElement;
    const fileInput = document.getElementById('file') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const dropzone = document.getElementById('dropzone') as HTMLLabelElement;
    const dropzoneText = document.getElementById('dropzone-text') as HTMLSpanElement;
    const result = document.getElementById('result') as HTMLDivElement;
    const errorBox = document.getElementById('error') as HTMLDivElement;
    const preview = document.getElementById('preview') as HTMLImageElement;
    const rawUrl = document.getElementById('raw-url') as HTMLInputElement;
    const mdUrl = document.getElementById('md-url') as HTMLInputElement;
    const bbUrl = document.getElementById('bb-url') as HTMLInputElement;

    // Remember password in sessionStorage so refreshes don't re-prompt.
    const stored = sessionStorage.getItem('sgh-upload-pw');
    if (stored) passwordInput.value = stored;

    fileInput.addEventListener('change', () => {
      if (fileInput.files?.[0]) {
        dropzoneText.textContent = fileInput.files[0].name;
      }
    });

    ['dragover', 'dragenter'].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.add('border-brand-500', 'bg-brand-50');
      }),
    );
    ['dragleave', 'drop'].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropzone.classList.remove('border-brand-500', 'bg-brand-50');
      }),
    );
    dropzone.addEventListener('drop', (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (dt?.files[0]) {
        fileInput.files = dt.files;
        dropzoneText.textContent = dt.files[0].name;
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      result.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Uploading…';

      try {
        const file = fileInput.files?.[0];
        if (!file) throw new Error('Pick a file first');

        const fd = new FormData();
        fd.append('password', passwordInput.value);
        fd.append('file', file);

        const res = await fetch('/api/upload', { method: 'POST', body: fd });
        const data = (await res.json()) as { url?: string; error?: string };
        if (!res.ok || !data.url) {
          throw new Error(data.error ?? `Upload failed (${res.status})`);
        }

        sessionStorage.setItem('sgh-upload-pw', passwordInput.value);

        preview.src = data.url;
        rawUrl.value = data.url;
        mdUrl.value = `![](${data.url})`;
        bbUrl.value = `[img]${data.url}[/img]`;
        result.classList.remove('hidden');
      } catch (err) {
        errorBox.textContent = err instanceof Error ? err.message : String(err);
        errorBox.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Upload';
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetId = btn.dataset.copy;
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement | null;
        if (!input) return;
        await navigator.clipboard.writeText(input.value);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => {
          btn.textContent = original;
        }, 1200);
      });
    });
  </script>
</BaseLayout>
