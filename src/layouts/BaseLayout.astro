---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Smart Gallery Hub — AI Metadata + Auto-Submit to Adobe Stock, Shutterstock & Getty | Microstock Workflow Software',
  description = 'Generate AI keywords, titles, and descriptions for thousands of stock photos and videos. Auto-submit to Adobe Stock, Shutterstock, and Getty Images / iStock — all from your desktop. AI runs locally on your machine. Free forever tier. Windows + Mac.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Optional analytics + search-console verification (set via Cloudflare Pages env vars).
// PUBLIC_ prefix is required for client-side access in Astro.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION;

const softwareApplicationLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Smart Gallery Hub',
  description:
    'Desktop application that generates AI metadata and auto-submits stock photos and videos to Adobe Stock, Shutterstock, and Getty Images / iStock.',
  applicationCategory: 'PhotographyApplication',
  applicationSubCategory: 'Stock photography workflow / microstock contributor tool',
  operatingSystem: 'Windows, macOS',
  url: 'https://smartgalleryhub.com',
  image: 'https://smartgalleryhub.com/og-image.png',
  offers: [
    {
      '@type': 'Offer',
      name: 'Free',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      category: 'Free tier — AI metadata generation, content-type organization, write to file (IPTC/XMP), 1 device',
    },
    {
      '@type': 'Offer',
      name: 'Pro Annual',
      price: '59.99',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      category: 'Pro annual subscription — adds automated submission, approval tracking, earnings dashboard, 5 devices',
    },
    {
      '@type': 'Offer',
      name: 'Pro Lifetime',
      price: '199.99',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      category: 'Pro lifetime — one-time payment, all Pro features forever, 5 devices',
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://smartgalleryhub.com/og-image.png" />
    <meta property="og:url" content="https://smartgalleryhub.com" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationLd)} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script set:html={`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${gaMeasurementId}');`}></script>
      </>
    )}
    <slot name="head" />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <header class="border-b border-gray-100">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-xl font-bold text-gray-900 hover:text-brand-700 transition-colors">
          <Image src={logoImage} alt="Smart Gallery Hub logo" class="w-8 h-8 rounded-lg" width={64} height={64} format="webp" quality={88} />
          Smart Gallery Hub
        </a>
        <div class="flex items-center gap-6 text-sm font-medium text-gray-600">
          <a href="/#features" class="hover:text-gray-900 transition-colors">Features</a>
          <a href="/#pricing" class="hover:text-gray-900 transition-colors">Pricing</a>
          <a href="/tutorials/" class="hover:text-gray-900 transition-colors">Tutorials</a>
          <a href="/download" class="hover:text-gray-900 transition-colors">Download</a>
          <a href="mailto:support@smartgalleryhub.com" class="hover:text-gray-900 transition-colors">Support</a>
          <a
            href="https://buy.polar.sh/polar_cl_F7zNynx5wcSfUm96w3eklh2cXR10EYJPdIGMB0rJnYg"
            class="bg-brand-600 text-white px-4 py-2 rounded-lg hover:bg-brand-700 transition-colors"
          >
            Subscribe Now
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-gray-100 mt-20">
      <div class="max-w-6xl mx-auto px-4 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
        <p>&copy; {new Date().getFullYear()} Smart Gallery Hub. All rights reserved.</p>
        <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center sm:justify-end">
          <a href="/tutorials/" class="hover:text-gray-700 transition-colors">Tutorials</a>
          <a href="/blog/" class="hover:text-gray-700 transition-colors">Blog</a>
          <a href="/privacy" class="hover:text-gray-700 transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-gray-700 transition-colors">Terms of Service</a>
          <a href="mailto:support@smartgalleryhub.com" class="hover:text-gray-700 transition-colors">Support</a>
        </div>
      </div>
    </footer>
  </body>
</html>
